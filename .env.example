# Copie ce fichier en ".env" et remplis les valeurs.
# Le fichier .env n'est jamais envoyé sur Git (il est dans .gitignore).

# Scoring IA — Gemini, offre gratuite : https://aistudio.google.com (Get API key)
GEMINI_API_KEY=

# Page Candidater (Claude, crédit prépayé) — https://platform.claude.com/settings/keys
# Sans clé, Gemini fait tout (gratuit).
ANTHROPIC_API_KEY=

# API France Travail, Offres d'emploi v2 (étape 2) — https://francetravail.io
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Google Jobs via SerpApi (étape 3) — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Careerjet (étape 3, ensuite) — https://www.careerjet.com/partners
CAREERJET_API_KEY=

# Gmail : lecture des alertes (étape 4) et envoi des mails (étape 10)
# Mot de passe d'application : compte Google > Sécurité > Validation en 2 étapes > Mots de passe des applications
GMAIL_ADRESSE=
GMAIL_MOT_DE_PASSE_APPLI=
# Adresse qui reçoit le récap et les alertes (laisser vide = GMAIL_ADRESSE)
EMAIL_DESTINATAIRE=
